# Copia a .env y rellena. tenancy se conecta como svc_tenancy.

# ── Base de datos ─────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_USER=svc_tenancy
DB_PASSWORD=CAMBIAR_tenancy
DB_NAME=SL_ASISTENCIAS

# ── App ───────────────────────────────────────────────────────────────────────
APP_TITLE=Tenancy Service
APP_VERSION=1.0.0
DEBUG=false
CORS_ORIGINS=

# ── JWT (mismo secreto que el resto: valida el token que emite identity) ───────
JWT_SECRET=
EMPRESA_ADMIN=99
