# ── Base de datos SYS 21 (Origen de empleados) ─────────────────────────────────────────────────────────────
SYS_21_URL_AGRICOLA=mssql+pyodbc://biView:BISys21@45.76.79.82:4329/ASL_Nomina?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
SYS_21_URL_AGRICOLA_COM=mssql+pyodbc://biView:BISys21@45.76.79.82:4329/ASL_Nomina_COM?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# ── Base de datos ─────────────────────────────────────────────────────────────
#  Usa las credenciales de Workers Service debido a que hace el POST, PUT, etc, pero este
# no reflejara directamente al front, este se encarga de escuchar y reflejar los cambios en 
# la BD de SYS21 y adaptarlos al sistema.

DB_HOST=postgres
DB_PORT=5432
DB_USER=svc_workers
DB_PASSWORD=CAMBIAR_workers
DB_NAME=SL_ASISTENCIAS

# ── Servidor de fotos (SSH/SFTP con llave) ────────────────────────────────────
# Las fotos viven en un servidor remoto; el archivo se llama como el id_emp
# (ej. 12345.jpg). La llave privada se monta read-only en el contenedor.
FOTOS_SFTP_HOST=
FOTOS_SFTP_PORT=22
FOTOS_SFTP_USER=
FOTOS_SFTP_KEY_PATH=/run/secrets/fotos_ssh_key
FOTOS_SFTP_KEY_PASSPHRASE=
FOTOS_SFTP_BASE_DIR=/ruta/remota/de/fotos
FOTOS_EXTENSIONES=jpg,jpeg,png

# ── Validación de foto (estricta, configurable) ───────────────────────────────
FOTO_MIN_WIDTH=320
FOTO_MIN_HEIGHT=320
FOTO_MAX_BYTES=8000000
FOTO_FORMATOS=JPEG,PNG
FOTO_DET_SCORE_MIN=0.65
FOTO_EXIGIR_ANTISPOOF=true

# ── Sincronización / scheduler ────────────────────────────────────────────────
SYNC_ENABLED=true
SYNC_INTERVAL_MINUTES=60
SYNC_RUN_ON_STARTUP=false
SYNC_BATCH_SIZE=500
SYNC_RECOG_CONCURRENCY=4

# ── Microservicio recognition (extracción de embeddings) ──────────────────────
RECOGNITION_SERVICE_URL=http://recognition:8000
RECOGNITION_INTERNAL_TOKEN=

# ── App ───────────────────────────────────────────────────────────────────────
APP_TITLE=Employee Monitoring Service
APP_VERSION=1.0.0
DEBUG=false
CORS_ORIGINS=