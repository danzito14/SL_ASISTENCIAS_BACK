# Copia a .env y rellena. workers se conecta como svc_workers.

# ── Base de datos ─────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_USER=svc_workers
DB_PASSWORD=CAMBIAR_workers
DB_NAME=SL_ASISTENCIAS

# ── App ───────────────────────────────────────────────────────────────────────
APP_TITLE=Workers Service
APP_VERSION=1.0.0
DEBUG=false
CORS_ORIGINS=

# ── JWT (mismo secreto que el resto: valida el token de identity) ──────────────
JWT_SECRET=
EMPRESA_ADMIN=99

# ── Microservicio recognition (para el enrolamiento) ──────────────────────────
RECOGNITION_SERVICE_URL=http://recognition:8000
RECOGNITION_INTERNAL_TOKEN=
