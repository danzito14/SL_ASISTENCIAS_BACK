# ── Base de datos ─────────────────────────────────────────────────────────────
# vigilancia corre como svc_vigilancia (mínimo privilegio): RW en camaras/
# eventos_camara, SELECT de tenancy/trabajadores, INSERT en escaneos/intentos_acceso
# + EXECUTE de validar_escaneos_lote/consolidar_asistencia_dia (mismo pipeline).
DB_HOST=postgres
DB_PORT=5432
DB_USER=svc_vigilancia
DB_PASSWORD=CAMBIAR_vigilancia
DB_NAME=SL_ASISTENCIAS

# ── Scanner del back (reusa recognition + registra la asistencia) ───────────────
# vigilancia manda los frames al scanner del back por el gateway; el motor de captura
# se loguea como cuenta de servicio (rol vigilancia_edge, scanner:use) y cachea el token.
SCANNER_BASE_URL=http://localhost:8000
VIGILANCIA_SERVICE_USER=vigilancia_edge_emp1
VIGILANCIA_SERVICE_PASSWORD=
SCANNER_TIMEOUT=20
SCANNER_USAR_LIVENESS=true
CAP_FRAMES_LIVENESS=3

# ── Cifrado de credenciales de cámara (Fernet) ──────────────────────────────────
# Genera con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VIGILANCIA_SECRET_KEY=

# ── Config interna del supervisor reid ──────────────────────────────────────────
# GET /vigilancia/reid/config entrega credenciales de DVR DESCIFRADAS (solo interno).
# El supervisor reid debe mandar este mismo valor en X-Reid-Token. Vacío = no se exige (dev).
REID_INTERNAL_TOKEN=

# ── Recognition (paso del rostro) ───────────────────────────────────────────────
# /reid/identificar manda el recorte al motor facial (mismo de asistencia) para anclar
# la identidad a la persona del reid. URL interna + token compartido con recognition.
RECOGNITION_URL=http://recognition:8000
RECOGNITION_INTERNAL_TOKEN=

# ── Auth (la valida el gateway; aquí solo se leen headers X-* y scopes) ─────────
EMPRESA_ADMIN=99
GATEWAY_INTERNAL_TOKEN=
AUTH_DISABLED=false

# ── App ─────────────────────────────────────────────────────────────────────────
APP_TITLE=Vigilancia Service
APP_VERSION=1.0.0
DEBUG=false
CORS_ORIGINS=
