# Copia a .env y rellena. identity se conecta como svc_identity (mínimo privilegio).

# ── Base de datos ─────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_USER=svc_identity
DB_PASSWORD=CAMBIAR_identity
DB_NAME=SL_ASISTENCIAS

# ── App ───────────────────────────────────────────────────────────────────────
APP_TITLE=Identity Service
APP_VERSION=1.0.0
DEBUG=false
CORS_ORIGINS=

# ── JWT ───────────────────────────────────────────────────────────────────────
# DEBE ser el MISMO JWT_SECRET que usan los demás servicios (validan este token).
# JWT_SECRET=
JWT_EXPIRE_MINUTES=480
ROLES_TOKEN_SIN_EXPIRACION=kiosko
EMPRESA_ADMIN=99
