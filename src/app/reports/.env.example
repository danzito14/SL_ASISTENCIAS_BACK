# Copia a .env y rellena. reports se conecta como svc_reports (SOLO LECTURA).

# ── Base de datos (idealmente una réplica de lectura) ─────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_USER=svc_reports
DB_PASSWORD=CAMBIAR_reports
DB_NAME=SL_ASISTENCIAS

# ── App ───────────────────────────────────────────────────────────────────────
APP_TITLE=Reports Service
APP_VERSION=1.0.1
DEBUG=false
CORS_ORIGINS=

# ── JWT (mismo secreto que el resto: valida el token de identity) ──────────────
JWT_SECRET=
EMPRESA_ADMIN=99
