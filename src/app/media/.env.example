# Copia a .env y rellena. media NO usa base de datos.

APP_TITLE=Media Service
APP_VERSION=1.0.0
DEBUG=false

# Carpeta de almacenamiento (en Docker se monta el volumen aquí).
MEDIA_DIR=/app/data
# Prefijo web con que se guarda la ruta en la BD del resto de servicios.
MEDIA_URL=/media

# Secreto compartido con el backend para la API interna. DEBE coincidir con el
# MEDIA_INTERNAL_TOKEN del backend. Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MEDIA_INTERNAL_TOKEN=
