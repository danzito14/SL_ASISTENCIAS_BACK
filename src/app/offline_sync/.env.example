# ── Base de datos ─────────────────────────────────────────────────────────────
# offline_sync corre como svc_offline (mínimo privilegio): SELECT de trabajadores/
# embeddings/áreas/puertas (roster) e INSERT en asistencia/intentos_acceso (ingesta)
# + upsert de trabajadores/embeddings (enrolamiento walk-in).
DB_HOST=postgres
DB_PORT=5432
DB_USER=svc_offline
DB_PASSWORD=CAMBIAR_offline
DB_NAME=SL_ASISTENCIAS

# ── Roster ────────────────────────────────────────────────────────────────────
ROSTER_TIPOS=campo,oficina,empaque
# Regla del roster (ver Roster_Service):
#   false = OPCIÓN A (estricto): trabajadores del tipo de área + permiso 'super'.
#   true  = además incluye permiso_escaneo='general' (activar cuando se afinen
#           los permisos por área; es un cambio de un solo valor, sin redeploy).
ROSTER_INCLUIR_GENERAL=false

# ── Ingesta ───────────────────────────────────────────────────────────────────
INGESTA_MAX_FILAS=50000

# ── Enrolamiento (walk-in) ────────────────────────────────────────────────────
ENROL_ORIGEN=apk
EMBEDDING_DIM=512
ENROL_MODELO_IA=buffalo_l

# ── Auth (la valida el gateway; aquí solo se leen headers X-* y scopes) ─────────
EMPRESA_ADMIN=99
GATEWAY_INTERNAL_TOKEN=
AUTH_DISABLED=false

# ── App ───────────────────────────────────────────────────────────────────────
APP_TITLE=Offline Sync Service
APP_VERSION=1.0.0
DEBUG=false
CORS_ORIGINS=
