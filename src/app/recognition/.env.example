# Copia a .env y rellena. recognition se conecta como svc_recognition (SOLO LECTURA).

# ── Base de datos ─────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_USER=svc_recognition
DB_PASSWORD=CAMBIAR_recognition
DB_NAME=SL_ASISTENCIAS

# ── App ───────────────────────────────────────────────────────────────────────
APP_TITLE=Recognition Service
APP_VERSION=1.0.0
DEBUG=false
PRELOAD_FACE_MODEL=true

# ── Anti-spoofing ─────────────────────────────────────────────────────────────
ANTISPOOFING_ACTIVO=true
ANTISPOOF_REAL_INDEX=1
ANTISPOOF_UMBRAL=0.6
ANTISPOOF_DIV255=false

# ── Token interno (compartido con el backend) ─────────────────────────────────
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(32))"
RECOGNITION_INTERNAL_TOKEN=
