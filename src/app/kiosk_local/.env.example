# kiosk_local — backend local del kiosko de escritorio (corre en la PC).
# ── BD LOCAL (postgres+pgvector en la PC) ──
DB_HOST=kiosk_postgres
DB_PORT=5432
DB_USER=root
DB_PASSWORD=CAMBIAR_kiosk
DB_NAME=SL_ASISTENCIAS
DEBUG=false
# ── NUBE (gateway de prod; el mismo que usa el APK) ──
CLOUD_BASE_URL=https://<TU-DOMINIO>/api
KIOSK_USER=kiosko_emp1
KIOSK_PASSWORD=CAMBIAR
KIOSK_TIPO=oficina
KIOSK_EMPRESA=1
KIOSK_TZ=America/Mazatlan
# ── Back LOCAL (el mismo de la nube, con MODO_KIOSKO=true) ──
# kiosk_local expone /scanner/* con el contrato de la nube y lo reenvía aquí, haciendo
# de gateway: el token prueba que la petición salió de kiosk_local.
BACKEND_LOCAL_URL=http://backend:8000
BACKEND_GATEWAY_TOKEN=CAMBIAR_gateway_kiosk
# Fallback a la nube cuando el back local no reconoce (recién enrolados). Solo se intenta
# con internet, y ese estado va cacheado, así que offline no frena el fichaje.
KIOSK_SCANNER_FALLBACK_NUBE=true
