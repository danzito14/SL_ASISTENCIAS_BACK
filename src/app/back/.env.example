# Copia este archivo a .env y rellena los valores. NO subas tu .env real.

# ── Base de datos (PostgreSQL) ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=FP_PRUEBAS

# ── App ───────────────────────────────────────────────────────────────────────
APP_TITLE=FE Scanner API
APP_VERSION=0.1.0
DEBUG=false

# ── Anti-spoofing ─────────────────────────────────────────────────────────────
ANTISPOOFING_ACTIVO=true
ANTISPOOF_REAL_INDEX=1
ANTISPOOF_UMBRAL=0.6
ANTISPOOF_DIV255=false

# ── Autenticación (JWT) ───────────────────────────────────────────────────────
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Minutos de validez del token para usuarios normales. 0 = no expira.
JWT_EXPIRE_MINUTES=480
# Roles cuyo token NUNCA expira (lista separada por comas). El kiosko 'scanner'
# está siempre encendido, así que su token no debe caducar.
ROLES_TOKEN_SIN_EXPIRACION=scanner
