# Copia este archivo a .env (en pruebas/docker/) y rellena los valores.
# Lo lee docker-compose.prod.yml para sustituir ${VARIABLES}. NO subas el .env real.

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=root
POSTGRES_PASSWORD=cambia-esta-clave-fuerte
POSTGRES_DB=SL_ASISTENCIAS

# ── Roles de microservicio (mínimo privilegio; ver roles_microservicio.sql) ────
# Contraseña con la que el servicio identity se conecta como svc_identity.
# DEBE coincidir con la que tenga ese rol en la BD. Cámbiala en prod.
SVC_IDENTITY_PASSWORD=CAMBIAR_identity
# Idem para recognition (svc_recognition, SOLO LECTURA).
SVC_RECOGNITION_PASSWORD=CAMBIAR_recognition
# Idem para tenancy (svc_tenancy).
SVC_TENANCY_PASSWORD=CAMBIAR_tenancy
# Idem para workers (svc_workers).
SVC_WORKERS_PASSWORD=CAMBIAR_workers
# Idem para reports (svc_reports, SOLO LECTURA).
SVC_REPORTS_PASSWORD=CAMBIAR_reports
# Idem para offline_sync (svc_offline; roster + ingesta del APK kiosko). Si la
# omites, el compose usa el default 'CAMBIAR_offline' (= el que la migración
# 2026_07_offline_sync.sql le pone al rol). En prod: pon una clave fuerte aquí y
# alinéala con  ALTER ROLE svc_offline PASSWORD '…';
SVC_OFFLINE_PASSWORD=CAMBIAR_offline

# ── JWT ───────────────────────────────────────────────────────────────────────
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Dominio(s) del front en producción, separados por comas. Ej:
# CORS_ORIGINS=https://app.tudominio.com
CORS_ORIGINS=

# ── Microservicio media ───────────────────────────────────────────────────────
# Secreto compartido entre el backend y media para su API interna (no se expone).
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(32))"
MEDIA_INTERNAL_TOKEN=

# ── Microservicio recognition ─────────────────────────────────────────────────
# Secreto compartido entre el backend y recognition para su API interna.
RECOGNITION_INTERNAL_TOKEN=

# ── Gateway (Traefik) ─────────────────────────────────────────────────────────
# Token que Traefik inyecta (X-Gateway-Token) y los servicios verifican para probar
# que el request pasó por el gateway (anti-bypass). Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Lo usan a la vez el middleware gateway-token (label del backend) y el
# GATEWAY_INTERNAL_TOKEN de backend/tenancy/workers/reports — UN solo valor.
GATEWAY_INTERNAL_TOKEN=CAMBIAR_gateway_token
