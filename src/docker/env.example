# Copia este archivo a .env (en pruebas/docker/) y rellena los valores.
# Lo lee docker-compose.prod.yml para sustituir ${VARIABLES}. NO subas el .env real.

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=root
POSTGRES_PASSWORD=cambia-esta-clave-fuerte
POSTGRES_DB=SL_ASISTENCIAS

# ── JWT ───────────────────────────────────────────────────────────────────────
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Dominio(s) del front en producción, separados por comas. Ej:
# CORS_ORIGINS=https://app.tudominio.com
CORS_ORIGINS=
