# Docker
docker-compose.override.yml

# Modelos ONNX pesados que sirve offline_sync al APK (w600k_r50.onnx ~167MB).
# NO se commitean: se copian del contenedor recognition al desplegar. El anti-spoof
# (1.7MB) sí está versionado en recognition/models/antispoof/.
src/docker/modelos_apk/

# Secretos — llaves SSH/privadas (NUNCA commitear). La carpeta secrets/ se monta
# en el contenedor con la llave del SFTP de fotos.
src/docker/secrets/
*.pem
*_ssh_key
*_ssh_key.pub

# Instalador de escritorio (Inno Setup) — artefactos GENERADOS (no versionar):
#   · Output/ + el .exe compilado del wizard.
#   · init.sql/roles que instalar.ps1 COPIA aquí al correr desde el repo (los
#     originales viven en src/docker/ y sí están versionados).
#   · el front-setup.exe que se baje, por si acaso.
src/docker/instalador/Output/
src/docker/instalador/*.exe
src/docker/instalador/init.sql
src/docker/instalador/roles_microservicio.sql